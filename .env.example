# ──────────────────────────────────────────────────────────
# Email Configuration (Resend)
# Get your API key from https://resend.com/api-keys
#
# RESEND_API_KEY       → Server-side secret. Set this in Vercel →
#                        Settings → Environment Variables (NOT in the browser).
#
# Optional:
# CONTACT_TO_EMAIL     → Where form messages are delivered (default: nairithrin143@gmail.com)
# CONTACT_FROM_EMAIL   → The "from" address. Before verifying a domain, use
#                        Resend's built-in sender: onboarding@resend.dev
# ──────────────────────────────────────────────────────────

RESEND_API_KEY=

